{
  "name": "@diatonic/web",
  "version": "0.5.2",
  "description": "Interactive web app for discovering musical scales and chords using a visual piano",
  "author": "Vegard Egeland",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@diatonic/piano": "^0.4.0",
    "kamasi": "^0.3.0",
    "modern-normalize": "^3.0.1",
    "preact": "^11.1.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat"
  }
}
